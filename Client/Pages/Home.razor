@page "/"
@using System.Text;
@using Shared.Models;
@inject HttpClient httpClient

<PageTitle>Home</PageTitle>

<h1>Token: @token</h1>

Código
<InputText class="form-control" @bind-Value="editingCode"></InputText>
<BR />
<button @onclick="UpdatePs2" class="btn btn-primary">Atualizar o p ési dois: @res</button>

<br />
@sucesso
@code {

	Project project = new();

	public string? token;

	public string? res;

	public string editingCode = string.Empty;
	public string sucesso = string.Empty;

	string api = "api/projects/";

	protected override async Task OnInitializedAsync()
	{

		HttpResponseMessage response = await httpClient.PostAsync(api + "new", null);

		var json = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();

		if (response.IsSuccessStatusCode)
		{
			if (json != null && json.TryGetValue("token", out string newToken))
			{
				token = newToken;
			}

		}
		else
		{
			var token = await response.Content.ReadAsStringAsync();
			Console.WriteLine($"Erro: {response.StatusCode}, resposta: {token}");
		}

	}

	public async Task UpdatePs2()
	{

		HttpContent content = new StringContent(editingCode, Encoding.UTF8, "text/plain");

		HttpResponseMessage response = await httpClient.PostAsync(api + token + "/main.js", content);

		if (response.IsSuccessStatusCode)
		{
			sucesso = "Sucesso";
		}
		else
		{
			sucesso = "not sucesso";
		}
	}
}